# SkillSnap — Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Get these from: https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for Google OAuth redirect — set to your app's base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Service role key for server-side admin operations (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Mapbox public token for the Discover map.
# Without it Discover still works — the map slot shows "Map coming soon".
# Get one from https://account.mapbox.com/access-tokens/ (starts with pk.)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-token-here
